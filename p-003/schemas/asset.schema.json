{
  "$defs": {
    "Selector": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "url",
            "ip",
            "cidr",
            "host",
            "namespace",
            "project"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "Selector",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "notice": {
      "const": "SYNTHETIC TRAINING ENGAGEMENT — NOT AUTHORIZATION FOR REAL-WORLD TESTING",
      "default": "SYNTHETIC TRAINING ENGAGEMENT — NOT AUTHORIZATION FOR REAL-WORLD TESTING",
      "title": "Notice",
      "type": "string"
    },
    "source": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "author": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,127}$",
      "title": "Author",
      "type": "string"
    },
    "reviewer": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewer"
    },
    "classification": {
      "default": "synthetic-internal",
      "enum": [
        "synthetic-public",
        "synthetic-internal"
      ],
      "title": "Classification",
      "type": "string"
    },
    "created_at": {
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$",
      "title": "Created At",
      "type": "string"
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "asset_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,127}$",
      "title": "Asset Id",
      "type": "string"
    },
    "tenant": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,127}$",
      "title": "Tenant",
      "type": "string"
    },
    "owner": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,127}$",
      "title": "Owner",
      "type": "string"
    },
    "service": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Service",
      "type": "string"
    },
    "environment": {
      "enum": [
        "local-lab",
        "offline"
      ],
      "title": "Environment",
      "type": "string"
    },
    "selector": {
      "$ref": "#/$defs/Selector"
    },
    "methods": {
      "items": {
        "enum": [
          "GET",
          "HEAD",
          "POST",
          "PUT",
          "OPTIONS"
        ],
        "type": "string"
      },
      "maxItems": 5,
      "minItems": 1,
      "title": "Methods",
      "type": "array"
    },
    "data_class": {
      "const": "synthetic-only",
      "default": "synthetic-only",
      "title": "Data Class",
      "type": "string"
    },
    "ownership": {
      "enum": [
        "synthetic-owned",
        "external-unverified"
      ],
      "title": "Ownership",
      "type": "string"
    },
    "included": {
      "title": "Included",
      "type": "boolean"
    },
    "third_party_restrictions": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "title": "Third Party Restrictions",
      "type": "array"
    },
    "trust_boundaries": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Trust Boundaries",
      "type": "array"
    }
  },
  "required": [
    "asset_id",
    "author",
    "content_digest",
    "created_at",
    "environment",
    "id",
    "included",
    "methods",
    "owner",
    "ownership",
    "selector",
    "service",
    "source",
    "tenant",
    "third_party_restrictions",
    "trust_boundaries"
  ],
  "title": "Asset",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p003.example.test/schemas/1.0/asset.schema.json"
}
