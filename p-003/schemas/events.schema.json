{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "notice": {
      "const": "SYNTHETIC TRAINING ENGAGEMENT — NOT AUTHORIZATION FOR REAL-WORLD TESTING",
      "default": "SYNTHETIC TRAINING ENGAGEMENT — NOT AUTHORIZATION FOR REAL-WORLD TESTING",
      "title": "Notice",
      "type": "string"
    },
    "source": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "author": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,127}$",
      "title": "Author",
      "type": "string"
    },
    "reviewer": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewer"
    },
    "classification": {
      "default": "synthetic-internal",
      "enum": [
        "synthetic-public",
        "synthetic-internal"
      ],
      "title": "Classification",
      "type": "string"
    },
    "created_at": {
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$",
      "title": "Created At",
      "type": "string"
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "engagement_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,127}$",
      "title": "Engagement Id",
      "type": "string"
    },
    "event_type": {
      "enum": [
        "create",
        "submit",
        "approve",
        "activate",
        "amend",
        "stop",
        "reject",
        "decision"
      ],
      "title": "Event Type",
      "type": "string"
    },
    "actor": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,127}$",
      "title": "Actor",
      "type": "string"
    },
    "purpose": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Purpose",
      "type": "string"
    },
    "previous_digest": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Previous Digest"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    }
  },
  "required": [
    "actor",
    "author",
    "content_digest",
    "created_at",
    "engagement_id",
    "event_type",
    "id",
    "payload",
    "previous_digest",
    "purpose",
    "sequence",
    "source"
  ],
  "title": "Event",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p003.example.test/schemas/1.0/events.schema.json"
}
