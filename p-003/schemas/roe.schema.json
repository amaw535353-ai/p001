{
  "$defs": {
    "Window": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Window",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "notice": {
      "const": "SYNTHETIC TRAINING ENGAGEMENT — NOT AUTHORIZATION FOR REAL-WORLD TESTING",
      "default": "SYNTHETIC TRAINING ENGAGEMENT — NOT AUTHORIZATION FOR REAL-WORLD TESTING",
      "title": "Notice",
      "type": "string"
    },
    "source": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "author": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,127}$",
      "title": "Author",
      "type": "string"
    },
    "reviewer": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewer"
    },
    "classification": {
      "default": "synthetic-internal",
      "enum": [
        "synthetic-public",
        "synthetic-internal"
      ],
      "title": "Classification",
      "type": "string"
    },
    "created_at": {
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$",
      "title": "Created At",
      "type": "string"
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "window": {
      "$ref": "#/$defs/Window"
    },
    "allowed": {
      "items": {
        "enum": [
          "passive-inspection",
          "config-review",
          "bounded-local-api",
          "synthetic-prompt-evaluation"
        ],
        "type": "string"
      },
      "maxItems": 4,
      "minItems": 1,
      "title": "Allowed",
      "type": "array"
    },
    "forbidden": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Forbidden",
      "type": "array"
    },
    "max_total_requests": {
      "maximum": 1000,
      "minimum": 1,
      "title": "Max Total Requests",
      "type": "integer"
    },
    "max_requests_per_minute": {
      "maximum": 60,
      "minimum": 1,
      "title": "Max Requests Per Minute",
      "type": "integer"
    },
    "max_cost_units": {
      "maximum": 1000,
      "minimum": 0,
      "title": "Max Cost Units",
      "type": "integer"
    },
    "max_interruption_ms": {
      "maximum": 100,
      "minimum": 0,
      "title": "Max Interruption Ms",
      "type": "integer"
    },
    "source_identities": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,127}$",
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Source Identities",
      "type": "array"
    },
    "human_checkpoint": {
      "const": true,
      "default": true,
      "title": "Human Checkpoint",
      "type": "boolean"
    },
    "emergency_contact": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Emergency Contact"
    },
    "contact_confirmed": {
      "title": "Contact Confirmed",
      "type": "boolean"
    },
    "stop_conditions": {
      "items": {
        "enum": [
          "budget-exhausted",
          "contact-missing",
          "data-breach",
          "service-interruption",
          "human-stop"
        ],
        "type": "string"
      },
      "maxItems": 5,
      "minItems": 5,
      "title": "Stop Conditions",
      "type": "array"
    },
    "recovery": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Recovery",
      "type": "string"
    },
    "communications": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Communications",
      "type": "string"
    }
  },
  "required": [
    "allowed",
    "author",
    "communications",
    "contact_confirmed",
    "content_digest",
    "created_at",
    "emergency_contact",
    "forbidden",
    "id",
    "max_cost_units",
    "max_interruption_ms",
    "max_requests_per_minute",
    "max_total_requests",
    "recovery",
    "source",
    "source_identities",
    "stop_conditions",
    "window"
  ],
  "title": "ROE",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p003.example.test/schemas/1.0/roe.schema.json"
}
