{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "notice": {
      "const": "SYNTHETIC TRAINING ENGAGEMENT — NOT AUTHORIZATION FOR REAL-WORLD TESTING",
      "default": "SYNTHETIC TRAINING ENGAGEMENT — NOT AUTHORIZATION FOR REAL-WORLD TESTING",
      "title": "Notice",
      "type": "string"
    },
    "source": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "author": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,127}$",
      "title": "Author",
      "type": "string"
    },
    "reviewer": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewer"
    },
    "classification": {
      "default": "synthetic-internal",
      "enum": [
        "synthetic-public",
        "synthetic-internal"
      ],
      "title": "Classification",
      "type": "string"
    },
    "created_at": {
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$",
      "title": "Created At",
      "type": "string"
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "data_class": {
      "const": "synthetic-only",
      "default": "synthetic-only",
      "title": "Data Class",
      "type": "string"
    },
    "storage_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,127}$",
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Storage Ids",
      "type": "array"
    },
    "access_roles": {
      "items": {
        "enum": [
          "requestor",
          "assessor",
          "reviewer",
          "owner"
        ],
        "type": "string"
      },
      "maxItems": 4,
      "minItems": 1,
      "title": "Access Roles",
      "type": "array"
    },
    "retention_days": {
      "maximum": 365,
      "minimum": 1,
      "title": "Retention Days",
      "type": "integer"
    },
    "redact_before_export": {
      "const": true,
      "default": true,
      "title": "Redact Before Export",
      "type": "boolean"
    },
    "deletion": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Deletion",
      "type": "string"
    },
    "incident_notification": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Incident Notification",
      "type": "string"
    },
    "custody_references": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,127}$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Custody References",
      "type": "array"
    }
  },
  "required": [
    "access_roles",
    "author",
    "content_digest",
    "created_at",
    "custody_references",
    "deletion",
    "id",
    "incident_notification",
    "retention_days",
    "source",
    "storage_ids"
  ],
  "title": "EvidencePolicy",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p003.example.test/schemas/1.0/evidence-policy.schema.json"
}
