      ],
      "title": "Window",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "notice": {
      "const": "SYNTHETIC TRAINING ENGAGEMENT — NOT AUTHORIZATION FOR REAL-WORLD TESTING",
      "default": "SYNTHETIC TRAINING ENGAGEMENT — NOT AUTHORIZATION FOR REAL-WORLD TESTING",
      "title": "Notice",
      "type": "string"
    },
    "source": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "author": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,127}$",
      "title": "Author",
      "type": "string"
    },
    "reviewer": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewer"
    },
    "classification": {
      "default": "synthetic-internal",
      "enum": [
        "synthetic-public",
        "synthetic-internal"
      ],
      "title": "Classification",
      "type": "string"
    },
    "created_at": {
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$",
      "title": "Created At",
      "type": "string"
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "engagement-policy",
      "title": "Kind",
      "type": "string"
    },
    "engagement_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,127}$",
      "title": "Engagement Id",
      "type": "string"
    },
    "engagement_version": {
      "minimum": 1,
      "title": "Engagement Version",
      "type": "integer"
    },
    "status": {
      "enum": [
        "DRAFT",
        "SUBMITTED",
        "APPROVED",
        "ACTIVE",
        "SUSPENDED",
        "EXPIRED",
        "CLOSED",
        "REJECTED",
        "REVOKED",
        "SUPERSEDED"
      ],
      "title": "Status",
      "type": "string"
    },
    "policy_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Policy Digest",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "target_inventory": {
      "items": {
        "$ref": "#/$defs/Asset"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Target Inventory",
      "type": "array"
    },
    "window": {
      "$ref": "#/$defs/Window"
    },
    "expires_at": {
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$",
      "title": "Expires At",
      "type": "string"
    },
    "resource_limits_and_stops": {
      "$ref": "#/$defs/ROE"
    },
    "evidence_policy": {
      "$ref": "#/$defs/EvidencePolicy"
    },
    "authority_provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/Authorization"
        },
        {
          "type": "null"
        }
      ]
    },
    "ledger_head": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Ledger Head",
      "type": "string"
    },
    "consumption": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Consumption",
      "type": "string"
    },
    "enforcement": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Enforcement",
      "type": "string"
    },
    "real_legal_authority": {
      "const": "NOT VERIFIED",
      "title": "Real Legal Authority",
      "type": "string"
    }
  },
  "required": [
    "author",
    "authority_provenance",
    "consumption",
    "content_digest",
    "created_at",
    "enforcement",
    "engagement_id",
    "engagement_version",
    "evidence_policy",
    "expires_at",
    "id",
    "kind",
    "ledger_head",
    "policy_digest",
    "real_legal_authority",
    "resource_limits_and_stops",
    "scope",
    "source",
    "status",
    "target_inventory",
    "window"
  ],
  "title": "PolicyManifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p003.example.test/schemas/1.0/engagement-policy.schema.json"
}
