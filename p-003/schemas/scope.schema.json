{
  "$defs": {
    "Exclusion": {
      "additionalProperties": false,
      "properties": {
        "selector": {
          "$ref": "#/$defs/Selector"
        },
        "reason": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "selector",
        "reason"
      ],
      "title": "Exclusion",
      "type": "object"
    },
    "Selector": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "url",
            "ip",
            "cidr",
            "host",
            "namespace",
            "project"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "Selector",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "notice": {
      "const": "SYNTHETIC TRAINING ENGAGEMENT — NOT AUTHORIZATION FOR REAL-WORLD TESTING",
      "default": "SYNTHETIC TRAINING ENGAGEMENT — NOT AUTHORIZATION FOR REAL-WORLD TESTING",
      "title": "Notice",
      "type": "string"
    },
    "source": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "author": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,127}$",
      "title": "Author",
      "type": "string"
    },
    "reviewer": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewer"
    },
    "classification": {
      "default": "synthetic-internal",
      "enum": [
        "synthetic-public",
        "synthetic-internal"
      ],
      "title": "Classification",
      "type": "string"
    },
    "created_at": {
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$",
      "title": "Created At",
      "type": "string"
    },
    "content_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "included_asset_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,127}$",
        "type": "string"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Included Asset Ids",
      "type": "array"
    },
    "exclusions": {
      "items": {
        "$ref": "#/$defs/Exclusion"
      },
      "maxItems": 256,
      "title": "Exclusions",
      "type": "array"
    },
    "activities": {
      "items": {
        "enum": [
          "passive-inspection",
          "config-review",
          "bounded-local-api",
          "synthetic-prompt-evaluation"
        ],
        "type": "string"
      },
      "maxItems": 4,
      "minItems": 1,
      "title": "Activities",
      "type": "array"
    },
    "procedures": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Procedures",
      "type": "array"
    },
    "project_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{0,127}$",
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Project Ids",
      "type": "array"
    },
    "candidate_risk_ids": {
      "items": {
        "maximum": 37,
        "minimum": 1,
        "type": "integer"
      },
      "maxItems": 37,
      "title": "Candidate Risk Ids",
      "type": "array"
    },
    "risk_mapping_status": {
      "const": "candidate hypotheses; taxonomy source unavailable",
      "default": "candidate hypotheses; taxonomy source unavailable",
      "title": "Risk Mapping Status",
      "type": "string"
    },
    "constraints": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Constraints",
      "type": "array"
    }
  },
  "required": [
    "activities",
    "author",
    "candidate_risk_ids",
    "constraints",
    "content_digest",
    "created_at",
    "exclusions",
    "id",
    "included_asset_ids",
    "procedures",
    "project_ids",
    "source"
  ],
  "title": "Scope",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://p003.example.test/schemas/1.0/scope.schema.json"
}
