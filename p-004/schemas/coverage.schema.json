{
  "$defs": {
    "Context": {
      "additionalProperties": false,
      "properties": {
        "approved_engagement_version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved Engagement Version"
        },
        "dataset_seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Seed"
        },
        "engagement_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engagement Id"
        },
        "environment_id": {
          "default": "local-lab",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:_.-]{0,127}$",
          "title": "Environment Id",
          "type": "string"
        },
        "git_commit": {
          "title": "Git Commit",
          "type": "string"
        },
        "mode": {
          "default": "offline",
          "enum": [
            "offline",
            "guarded-http"
          ],
          "title": "Mode",
          "type": "string"
        },
        "outcome": {
          "default": "COMPLETE",
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "BLOCKED",
            "ERROR"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "policy_digest": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Digest"
        },
        "run_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:_.-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "sanitization_status": {
          "const": "allowlist-projection-and-redaction",
          "default": "allowlist-projection-and-redaction",
          "title": "Sanitization Status",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "timestamp_utc": {
          "title": "Timestamp Utc",
          "type": "string"
        },
        "tool_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "timestamp_utc",
        "git_commit"
      ],
      "title": "Context",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "known_denominator": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Known Denominator"
        },
        "processed": {
          "minimum": 0,
          "title": "Processed",
          "type": "integer"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "status": {
          "enum": [
            "discovered",
            "not_observed",
            "out_of_scope",
            "blocked",
            "skipped",
            "unverified",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target",
        "status",
        "processed",
        "reason"
      ],
      "title": "Coverage",
      "type": "object"
    }
  },
  "$id": "urn:p004:coverage:1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "context": {
      "$ref": "#/$defs/Context"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/Coverage"
      },
      "title": "Records",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Snapshot Digest",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "context",
    "snapshot_digest",
    "records"
  ],
  "title": "coverageExport",
  "type": "object"
}
