#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
# CPU wheels only. No CUDA/GPU dependencies or disabled integrity checks.
.venv/bin/python -m pip install torch==2.15.0+cpu --index-url https://download.pytorch.org/whl/cpu
.venv/bin/python -m pip install -r requirements-sdv.lock --extra-index-url https://download.pytorch.org/whl/cpu
.venv/bin/python -m pip check
