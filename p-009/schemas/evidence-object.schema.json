{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "event",
        "import"
      ],
      "title": "Kind",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "size": {
      "maximum": 1048576,
      "minimum": 0,
      "title": "Size",
      "type": "integer"
    }
  },
  "required": [
    "sha256",
    "size",
    "kind"
  ],
  "title": "ObjectRef",
  "type": "object"
}
