{
  "$defs": {
    "Link": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "engagement",
            "source",
            "evidence",
            "observation",
            "finding",
            "risk",
            "remediation",
            "retest",
            "retest-plan",
            "acceptance",
            "atlas",
            "report",
            "redmine-sync"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "sha256"
      ],
      "title": "Link",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attacker_capability": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Attacker Capability",
      "type": "string"
    },
    "availability_impact": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Availability Impact",
      "type": "string"
    },
    "business_impact": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Business Impact",
      "type": "string"
    },
    "control_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
        "type": "string"
      },
      "maxItems": 30,
      "title": "Control Ids",
      "type": "array"
    },
    "data_impact": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Data Impact",
      "type": "string"
    },
    "false_positive_analysis": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "False Positive Analysis",
      "type": "string"
    },
    "inspected_evidence": {
      "items": {
        "$ref": "#/$defs/Link"
      },
      "maxItems": 30,
      "minItems": 1,
      "title": "Inspected Evidence",
      "type": "array"
    },
    "limitations": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 30,
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "reproduction_steps": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Reproduction Steps",
      "type": "array"
    },
    "requirement_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
        "type": "string"
      },
      "maxItems": 30,
      "minItems": 1,
      "title": "Requirement Ids",
      "type": "array"
    },
    "security_impact": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Security Impact",
      "type": "string"
    }
  },
  "required": [
    "requirement_ids",
    "attacker_capability",
    "reproduction_steps",
    "security_impact",
    "business_impact",
    "data_impact",
    "availability_impact",
    "false_positive_analysis",
    "limitations",
    "inspected_evidence"
  ],
  "title": "Validation",
  "type": "object"
}
