{
  "$defs": {
    "Link": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "engagement",
            "source",
            "evidence",
            "observation",
            "finding",
            "risk",
            "remediation",
            "retest",
            "retest-plan",
            "acceptance",
            "atlas",
            "report",
            "redmine-sync"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "sha256"
      ],
      "title": "Link",
      "type": "object"
    },
    "TestRef": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/Link"
        },
        "test_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
          "title": "Test Id",
          "type": "string"
        }
      },
      "required": [
        "source",
        "test_id"
      ],
      "title": "TestRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "comparability_criteria": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Comparability Criteria",
      "type": "string"
    },
    "expected_behavior": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Expected Behavior",
      "type": "string"
    },
    "original_tests": {
      "items": {
        "$ref": "#/$defs/TestRef"
      },
      "maxItems": 30,
      "minItems": 1,
      "title": "Original Tests",
      "type": "array"
    },
    "planned_checks": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 30,
      "minItems": 1,
      "title": "Planned Checks",
      "type": "array"
    },
    "remediation": {
      "$ref": "#/$defs/Link"
    }
  },
  "required": [
    "remediation",
    "original_tests",
    "planned_checks",
    "comparability_criteria",
    "expected_behavior"
  ],
  "title": "RetestPlanInput",
  "type": "object"
}
