{
  "$defs": {
    "Link": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "engagement",
            "source",
            "evidence",
            "observation",
            "finding",
            "risk",
            "remediation",
            "retest",
            "retest-plan",
            "acceptance",
            "atlas",
            "report",
            "redmine-sync"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "sha256"
      ],
      "title": "Link",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "basis": {
      "enum": [
        "REPRODUCTION_RECORD",
        "SOURCE_TEST",
        "REFERENCE"
      ],
      "title": "Basis",
      "type": "string"
    },
    "evidence_quality": {
      "default": "UNKNOWN",
      "enum": [
        "UNKNOWN",
        "INSUFFICIENT",
        "LIMITED",
        "CORROBORATED"
      ],
      "title": "Evidence Quality",
      "type": "string"
    },
    "excerpt": {
      "anyOf": [
        {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Excerpt"
    },
    "excerpt_selected_by": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Excerpt Selected By"
    },
    "human_review_status": {
      "default": "PENDING",
      "enum": [
        "PENDING",
        "INSPECTED"
      ],
      "title": "Human Review Status",
      "type": "string"
    },
    "integrity_limit": {
      "default": "SHA-256 checks byte consistency. Source authenticity, trusted time and independent custody are unverified.",
      "title": "Integrity Limit",
      "type": "string"
    },
    "integrity_status": {
      "enum": [
        "VERIFIED_BYTES",
        "REFERENCE_ONLY",
        "UNAVAILABLE"
      ],
      "title": "Integrity Status",
      "type": "string"
    },
    "limitations": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "media_type": {
      "anyOf": [
        {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Media Type"
    },
    "observation_ref": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{16}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observation Ref"
    },
    "redaction_status": {
      "enum": [
        "METADATA_ONLY",
        "SELECTED_REDACTED_EXCERPT"
      ],
      "title": "Redaction Status",
      "type": "string"
    },
    "schema_version": {
      "const": "p010-evidence-1.0",
      "default": "p010-evidence-1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/Link"
    },
    "source_artifact_ref": {
      "anyOf": [
        {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Artifact Ref"
    },
    "source_record_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
      "title": "Source Record Id",
      "type": "string"
    },
    "source_time": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Time"
    },
    "trace_ref": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trace Ref"
    },
    "verified_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verified Sha256"
    },
    "verified_size": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verified Size"
    }
  },
  "required": [
    "source",
    "source_record_id",
    "basis",
    "integrity_status",
    "redaction_status",
    "limitations"
  ],
  "title": "Evidence",
  "type": "object"
}
