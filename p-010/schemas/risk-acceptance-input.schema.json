{
  "$defs": {
    "Link": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "engagement",
            "source",
            "evidence",
            "observation",
            "finding",
            "risk",
            "remediation",
            "retest",
            "retest-plan",
            "acceptance",
            "atlas",
            "report",
            "redmine-sync"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "sha256"
      ],
      "title": "Link",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "constraints": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 30,
      "minItems": 1,
      "title": "Constraints",
      "type": "array"
    },
    "decision": {
      "enum": [
        "ACCEPTED",
        "REJECTED"
      ],
      "title": "Decision",
      "type": "string"
    },
    "review_by": {
      "format": "date-time",
      "title": "Review By",
      "type": "string"
    },
    "risk": {
      "$ref": "#/$defs/Link"
    },
    "scope_refs": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
        "type": "string"
      },
      "maxItems": 30,
      "minItems": 1,
      "title": "Scope Refs",
      "type": "array"
    },
    "source_reference": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Source Reference",
      "type": "string"
    }
  },
  "required": [
    "risk",
    "scope_refs",
    "decision",
    "constraints",
    "review_by",
    "source_reference"
  ],
  "title": "AcceptanceInput",
  "type": "object"
}
