{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
          "title": "Ref",
          "type": "string"
        },
        "role": {
          "enum": [
            "AUTHOR",
            "REVIEWER",
            "REMEDIATION_OWNER",
            "RISK_OWNER",
            "CUSTODIAN"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "role"
      ],
      "title": "Actor",
      "type": "object"
    },
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Component",
          "type": "string"
        },
        "environment": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
          "title": "Environment",
          "type": "string"
        },
        "included": {
          "title": "Included",
          "type": "boolean"
        },
        "ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
          "title": "Ref",
          "type": "string"
        },
        "scope_ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
          "title": "Scope Ref",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "component",
        "environment",
        "scope_ref",
        "included"
      ],
      "title": "Asset",
      "type": "object"
    },
    "Window": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Window",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actors": {
      "items": {
        "$ref": "#/$defs/Actor"
      },
      "maxItems": 50,
      "minItems": 2,
      "title": "Actors",
      "type": "array"
    },
    "assessment_objectives": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Assessment Objectives",
      "type": "array"
    },
    "assessment_scope_ref": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
      "title": "Assessment Scope Ref",
      "type": "string"
    },
    "assessment_window": {
      "$ref": "#/$defs/Window"
    },
    "assets": {
      "items": {
        "$ref": "#/$defs/Asset"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Assets",
      "type": "array"
    },
    "authority_notice": {
      "default": "Synthetic training engagement. Legal authority, signer identity, and target enforcement are unverified.",
      "title": "Authority Notice",
      "type": "string"
    },
    "client_ref": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
      "title": "Client Ref",
      "type": "string"
    },
    "exclusions": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "title": "Exclusions",
      "type": "array"
    },
    "limitations": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Limitations",
      "type": "array"
    },
    "methodology_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
      "title": "Methodology Version",
      "type": "string"
    },
    "p003_policy_digest": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "P003 Policy Digest"
    },
    "schema_version": {
      "const": "p010-engagement-1.0",
      "default": "p010-engagement-1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "SYNTHETIC_EXERCISE",
        "HISTORICAL_REVIEW"
      ],
      "title": "Status",
      "type": "string"
    },
    "title": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "title",
    "client_ref",
    "status",
    "assessment_scope_ref",
    "assessment_window",
    "assets",
    "exclusions",
    "assessment_objectives",
    "methodology_version",
    "actors",
    "limitations"
  ],
  "title": "Engagement",
  "type": "object"
}
