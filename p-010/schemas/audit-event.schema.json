{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
          "title": "Ref",
          "type": "string"
        },
        "role": {
          "enum": [
            "AUTHOR",
            "REVIEWER",
            "REMEDIATION_OWNER",
            "RISK_OWNER",
            "CUSTODIAN"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "role"
      ],
      "title": "Actor",
      "type": "object"
    },
    "Link": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "engagement",
            "source",
            "evidence",
            "observation",
            "finding",
            "risk",
            "remediation",
            "retest",
            "retest-plan",
            "acceptance",
            "atlas",
            "report",
            "redmine-sync"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "sha256"
      ],
      "title": "Link",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "#/$defs/Actor"
    },
    "at": {
      "format": "date-time",
      "title": "At",
      "type": "string"
    },
    "engagement_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
      "title": "Engagement Id",
      "type": "string"
    },
    "operation": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$",
      "title": "Operation",
      "type": "string"
    },
    "previous": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Previous"
    },
    "previous_version": {
      "anyOf": [
        {
          "$ref": "#/$defs/Link"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rationale": {
      "title": "Rationale",
      "type": "string"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/Link"
      },
      "maxItems": 4000,
      "title": "Records",
      "type": "array"
    },
    "schema_version": {
      "const": "p010-audit-event-1.0",
      "default": "p010-audit-event-1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    }
  },
  "required": [
    "sequence",
    "previous",
    "at",
    "actor",
    "engagement_id",
    "operation",
    "rationale"
  ],
  "title": "AuditEvent",
  "type": "object"
}
