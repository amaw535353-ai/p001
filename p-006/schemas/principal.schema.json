{
  "additionalProperties": false,
  "properties": {
    "subject": {
      "pattern": "^[a-f0-9-]{36}$",
      "title": "Subject",
      "type": "string"
    },
    "username": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "title": "Username",
      "type": "string"
    },
    "tenant": {
      "enum": [
        "tenant-a",
        "tenant-b",
        "platform"
      ],
      "title": "Tenant",
      "type": "string"
    },
    "roles": {
      "items": {
        "enum": [
          "user",
          "tenant-admin",
          "platform-admin"
        ],
        "type": "string"
      },
      "title": "Roles",
      "type": "array"
    },
    "enabled": {
      "default": true,
      "title": "Enabled",
      "type": "boolean"
    }
  },
  "required": [
    "subject",
    "username",
    "tenant",
    "roles"
  ],
  "title": "Principal",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:p006:principal:v1"
}
