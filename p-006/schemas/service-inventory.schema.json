{
  "$defs": {
    "Endpoint": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "p006-endpoint-v1",
          "default": "p006-endpoint-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "service_id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "title": "Service Id",
          "type": "string"
        },
        "method": {
          "enum": [
            "GET",
            "POST"
          ],
          "title": "Method",
          "type": "string"
        },
        "path": {
          "pattern": "^/[a-zA-Z0-9_/{}/.-]*$",
          "title": "Path",
          "type": "string"
        },
        "response_schema_ref": {
          "title": "Response Schema Ref",
          "type": "string"
        }
      },
      "required": [
        "service_id",
        "method",
        "path",
        "response_schema_ref"
      ],
      "title": "Endpoint",
      "type": "object"
    },
    "Service": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "image": {
          "title": "Image",
          "type": "string"
        },
        "networks": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
            "type": "string"
          },
          "title": "Networks",
          "type": "array"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "build_recipe_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Build Recipe Sha256"
        }
      },
      "required": [
        "id",
        "image",
        "networks",
        "port"
      ],
      "title": "Service",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "p006-inventory-v1",
      "default": "p006-inventory-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "services": {
      "items": {
        "$ref": "#/$defs/Service"
      },
      "title": "Services",
      "type": "array"
    },
    "endpoints": {
      "items": {
        "$ref": "#/$defs/Endpoint"
      },
      "title": "Endpoints",
      "type": "array"
    }
  },
  "required": [
    "services",
    "endpoints"
  ],
  "title": "ServiceInventory",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:p006:service-inventory:v1"
}
