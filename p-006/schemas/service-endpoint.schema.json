{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "p006-endpoint-v1",
      "default": "p006-endpoint-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "service_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "title": "Service Id",
      "type": "string"
    },
    "method": {
      "enum": [
        "GET",
        "POST"
      ],
      "title": "Method",
      "type": "string"
    },
    "path": {
      "pattern": "^/[a-zA-Z0-9_/{}/.-]*$",
      "title": "Path",
      "type": "string"
    },
    "response_schema_ref": {
      "title": "Response Schema Ref",
      "type": "string"
    }
  },
  "required": [
    "service_id",
    "method",
    "path",
    "response_schema_ref"
  ],
  "title": "Endpoint",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:p006:service-endpoint:v1"
}
