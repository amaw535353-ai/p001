{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P006 target adapter contract, version 1, contract only",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_id", "target_version", "implementation_ref", "origin", "capabilities", "endpoints", "runtime_status"],
  "properties": {
    "schema_version": {"const": "p006-target-adapter-v1"},
    "target_id": {"type": "string", "pattern": "^p006-[a-z0-9-]+$"},
    "target_version": {"type": ["string", "null"]},
    "implementation_ref": {"type": ["string", "null"]},
    "origin": {"type": ["string", "null"]},
    "capabilities": {"type": "array", "items": {"type": "string"}, "maxItems": 16},
    "endpoints": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["method", "path", "response_schema_ref"], "properties": {"method": {"enum": ["GET", "POST"]}, "path": {"type": "string"}, "response_schema_ref": {"type": "string"}}}, "maxItems": 32},
    "runtime_status": {"enum": ["BLOCKED", "NOT_TESTED"]}
  }
}
