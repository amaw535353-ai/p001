{
  "$defs": {
    "RunnerResult": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "enum": [
            "offline",
            "promptfoo",
            "inspect_ai",
            "zap",
            "playwright",
            "p006"
          ],
          "title": "Adapter",
          "type": "string"
        },
        "commands": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Commands",
          "type": "array"
        },
        "error_class": {
          "default": "none",
          "enum": [
            "none",
            "dependency",
            "scope",
            "timeout",
            "provider",
            "unsupported",
            "invalid",
            "resource"
          ],
          "title": "Error Class",
          "type": "string"
        },
        "executed": {
          "title": "Executed",
          "type": "boolean"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exit Code"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "observed": {
          "additionalProperties": true,
          "title": "Observed",
          "type": "object"
        },
        "original_status": {
          "title": "Original Status",
          "type": "string"
        },
        "samples": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 64,
          "title": "Samples",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tool_version": {
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "adapter",
        "executed",
        "original_status",
        "exit_code",
        "tool_version"
      ],
      "title": "RunnerResult",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assertion": {
      "title": "Assertion",
      "type": "string"
    },
    "compatibility": {
      "additionalProperties": true,
      "title": "Compatibility",
      "type": "object"
    },
    "compatibility_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Compatibility Hash",
      "type": "string"
    },
    "control_ids": {
      "items": {
        "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$",
        "type": "string"
      },
      "title": "Control Ids",
      "type": "array"
    },
    "definition_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Definition Hash",
      "type": "string"
    },
    "expected": {
      "additionalProperties": true,
      "title": "Expected",
      "type": "object"
    },
    "observed": {
      "additionalProperties": true,
      "title": "Observed",
      "type": "object"
    },
    "runner": {
      "$ref": "#/$defs/RunnerResult"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_TESTED",
        "INCONCLUSIVE",
        "NOT_APPLICABLE",
        "FLAKY"
      ],
      "title": "Status",
      "type": "string"
    },
    "test_id": {
      "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$",
      "title": "Test Id",
      "type": "string"
    },
    "test_version": {
      "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,95}$",
      "title": "Test Version",
      "type": "string"
    }
  },
  "required": [
    "test_id",
    "test_version",
    "control_ids",
    "status",
    "assertion",
    "expected",
    "observed",
    "runner",
    "definition_hash",
    "compatibility_hash",
    "compatibility"
  ],
  "title": "NormalizedResult",
  "type": "object"
}
