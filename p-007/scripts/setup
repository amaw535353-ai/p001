#!/usr/bin/env bash
set -Eeuo pipefail
cd "$(dirname "$0")/.."
python3 -c 'import sys; assert sys.version_info[:2] == (3, 12), "Python 3.12 required"'
python3 -m venv .venv
mkdir -p .tools/wheels .tools/cache
lock=requirements.lock
if [[ "${1:-}" == --tools ]]; then lock=requirements-tools.lock; fi
if [[ "${P007_OFFLINE:-0}" != 1 ]]; then
  .venv/bin/python -m pip --cache-dir .tools/cache download --require-hashes --only-binary=:all: --dest .tools/wheels -r "$lock"
fi
.venv/bin/python -m pip install --no-index --find-links=.tools/wheels --require-hashes --only-binary=:all: -r "$lock"
.venv/bin/python -m pip install --no-index --no-deps --no-build-isolation -e . -e ../p-002 -e ../p-003 -e ../p-004 -e ../p-005
.venv/bin/python -m pip check
if [[ "${1:-}" == --tools ]]; then
  python3 -m venv .tools/inspect
  mkdir -p .tools/inspect-wheels .tools/node
  if [[ "${P007_OFFLINE:-0}" != 1 ]]; then
    .tools/inspect/bin/python -m pip --cache-dir .tools/cache download --require-hashes --only-binary=:all: --dest .tools/inspect-wheels -r requirements-inspect.lock
  fi
  .tools/inspect/bin/python -m pip install --no-index --find-links=.tools/inspect-wheels --require-hashes --only-binary=:all: -r requirements-inspect.lock
  cp tools/package.json tools/package-lock.json .tools/node/
  npm_options=()
  if [[ "${P007_OFFLINE:-0}" == 1 ]]; then npm_options+=(--offline); fi
  npm --cache .tools/npm-cache ci --prefix .tools/node --no-audit --no-fund "${npm_options[@]}"
  .venv/bin/python scripts/install-zap.py
fi
