      {
        "kind": "ServiceAccount",
        "name": "lab-api",
        "namespace": "tenant-a"
      }
    ]
  },
  {
    "apiVersion": "v1",
    "kind": "ConfigMap",
    "metadata": {
      "name": "public-fixtures",
      "namespace": "tenant-a",
      "labels": {
        "project": "p001"
      }
    },
    "data": {
      "classification": "synthetic-only"
    }
  },
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "name": "api",
      "namespace": "tenant-a",
      "labels": {
        "project": "p001"
      }
    },
    "spec": {
      "replicas": 1,
      "selector": {
        "matchLabels": {
          "app": "api",
          "tenant": "tenant-a",
          "project": "p001"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app": "api",
            "tenant": "tenant-a",
            "project": "p001"
          }
        },
        "spec": {
          "serviceAccountName": "lab-api",
          "automountServiceAccountToken": false,
          "securityContext": {
            "runAsNonRoot": true,
            "runAsUser": 10001,
            "runAsGroup": 10001,
            "seccompProfile": {
              "type": "RuntimeDefault"
            }
          },
          "containers": [
            {
              "name": "api",
              "image": "p001-workload:local",
              "imagePullPolicy": "Never",
              "ports": [
                {
                  "containerPort": 8080
                }
              ],
              "env": [
                {
                  "name": "P001_MODE",
                  "value": "api"
                },
                {
                  "name": "P001_TENANT",
                  "value": "tenant-a"
                },
                {
                  "name": "P001_S3_ENDPOINT",
                  "value": "http://localstack.emulator.svc.cluster.local:4566"
                }
              ],
              "resources": {
                "requests": {
                  "cpu": "50m",
                  "memory": "64Mi"
                },
                "limits": {
                  "cpu": "500m",
                  "memory": "192Mi"
                }
              },
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "readOnlyRootFilesystem": true,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                }
              },
              "readinessProbe": {
                "httpGet": {
                  "path": "/readyz",
                  "port": 8080
                },
                "initialDelaySeconds": 2
              },
              "livenessProbe": {
                "httpGet": {
                  "path": "/healthz",
                  "port": 8080
                },
                "initialDelaySeconds": 5
              }
            }
          ]
        }
      }
    }
  },
