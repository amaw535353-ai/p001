#!/usr/bin/env python3
"""Dependency-independent structural and narrow secret checks; not a full scanner."""
import ast,json,re,subprocess
from pathlib import Path
root=Path(__file__).resolve().parents[1]
for f in root.rglob('*.py'):
    # Ignored runtime tool homes can contain non-CPython templates (e.g. ZAP Jython).
    if not any(x in f.parts for x in ['.tools','.venv','.terraform','.runtime']):ast.parse(f.read_text())
for base in ['infra','schemas']:
    for f in (root/base).rglob('*.json'):
        if '.terraform' not in f.parts:json.loads(f.read_text())
for f in (root/'scripts').iterdir():
    if f.is_file() and f.read_bytes().startswith(b'#!/usr/bin/env bash'):
        subprocess.run(['bash','-n',str(f)],check=True)
resources=json.loads((root/'infra/kubernetes/resources.json').read_text())
for r in resources:
    if r['kind']=='Deployment':
        p=r['spec']['template']['spec'];assert p['automountServiceAccountToken'] is False
        assert p['securityContext']['runAsNonRoot']
        for c in p['containers']:
            assert c['resources']['limits'] and c['resources']['requests']
            assert c['securityContext']['capabilities']['drop']==['ALL']
            assert c['securityContext']['readOnlyRootFilesystem']
    if r['kind']=='Service':assert r['spec']['type']=='ClusterIP'
for f in root.rglob('*'):
    if not f.is_file() or any(x in f.parts for x in ['.git','.tools','.runtime','.terraform','evidence','__pycache__','.venv']):continue
    try:s=f.read_text()
    except UnicodeError:continue
    for pattern in [r'AKIA[0-9A-Z]{16}',r'-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----',r'ghp_[A-Za-z0-9]{36}']:
        assert not re.search(pattern,s),f'potential secret: {f.relative_to(root)}'
print('PASS structural checks and narrow secret patterns (not a vulnerability assessment)')
