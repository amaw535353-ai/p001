#!/usr/bin/env python3
"""Pinned, nonprivileged Linux amd64 setup. TLS and SHA-256 stay enabled."""
import hashlib,io,json,os,platform,subprocess,zipfile
from pathlib import Path
R=Path(__file__).resolve().parents[1];os.chdir(R)
if platform.system()!='Linux' or platform.machine() not in ['x86_64','amd64']:
    raise SystemExit('BLOCKED: pinned tool installer supports Linux x86_64 only; see host matrix')
b=R/'.tools/bin';b.mkdir(parents=True,exist_ok=True)
for name,x in json.load(open('infra/tools.lock.json')).items():
    target=b/name;expected=x.get('binary_sha256',x['sha256'])
    if target.exists() and hashlib.sha256(target.read_bytes()).hexdigest()==expected:continue
    raw=subprocess.check_output(['curl','--fail','--silent','--show-error','--location','--proto','=https','--tlsv1.2',x['url']])
    assert hashlib.sha256(raw).hexdigest()==x['sha256'],name+' artifact checksum mismatch'
    if name=='tofu':raw=zipfile.ZipFile(io.BytesIO(raw)).read('tofu')
    assert hashlib.sha256(raw).hexdigest()==expected
    target.write_bytes(raw);target.chmod(0o755)
w=R/'.tools/wheels';w.mkdir(exist_ok=True)
subprocess.run(['python3','-m','pip','download','--require-hashes','--only-binary=:all:','--dest',str(w),'-r','services/lab-api/requirements.lock'],check=True)
os.environ['PATH']=str(b)+os.pathsep+os.environ['PATH']
subprocess.run(['./scripts/tofu-init'],check=True)
subprocess.run(['tofu','-chdir=infra/opentofu/local','validate'],check=True)
subprocess.run(['make','unit','static'],check=True)
