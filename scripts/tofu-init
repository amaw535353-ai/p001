#!/usr/bin/env python3
"""OpenTofu 1.13 registry-shim workaround: enforce byte-identical checked-in lock."""
import os,subprocess
from pathlib import Path
r=Path(__file__).resolve().parents[1];os.chdir(r)
p=r/'infra/opentofu/local/.terraform.lock.hcl';before=p.read_bytes()
try:
    subprocess.run(['tofu','-chdir=infra/opentofu/local','init','-input=false'],check=True)
    if p.read_bytes()!=before:raise RuntimeError('Provider lock changed unexpectedly; restored original; review a separate dependency update')
finally:
    if p.read_bytes()!=before:p.write_bytes(before)
print('PASS: signed provider initialization preserved exact dependency lock bytes')
